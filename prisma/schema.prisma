generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // URL para las migraciones de la base de datos
}

// tabla de usuarios en la base de datos
model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("STAFF") // ADMIN | STAFF
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// catalogo de servicios
model Service {
  id          String         @id @default(cuid())
  name        String         @unique // por ejemplo la equinoterapia
  prices      ServicePrice[]
  patients    PatientService[]
}

// aqui configuramos los precios
model ServicePrice {
  id             String   @id @default(cuid())
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id])
  frequency      Int      // cuantas veces a la semana viene
  scheduleType   String   // tipo de horario a b o c
  monthlyPrice   Float    // lo que cuesta al mes
  effectiveDate  DateTime @default(now()) // guarda el historial para que no se pierda
  isActive       Boolean  @default(true) // apaga los precios viejos
}

// tabla de pacientes importantes
model Patient {
  id               String          @id @default(cuid())
  folio            String?         @unique // ejemplo de folio
  fullName         String
  category         String          @default("PARTICULAR") // categoria que cambia
  status           PatientStatus   @default(ACTIVE)
  
  sponsorId        String?         // si tiene padrino se lo ponemos aqui
  sponsor          Sponsor?        @relation(fields: [sponsorId], references: [id])

  // Servicios vinculados al paciente
  services         PatientService[]
  payments         Payment[]
  charges          Charge[]        // los cargos a pagar
  notes            String?         // notas random
  suspensionReason String?         // por que se dio de baja
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Sponsor {
  id                 String           @id @default(cuid())
  folio              String?          // ejemplo p3
  name               String
  monthlyCommitment  Float            @default(0)
  billingData        String?          // Información para facturar
  comments           String?          // comentarios del padrino
  birthday           DateTime?        // Fecha de nacimiento
  contributionMethod String?          // formas de pagar
  periodicity        String           @default("MENSUAL") // MENSUAL, TRIMESTRAL, ANUAL
  whatsapp           String?          // Número de WhatsApp del padrino
  billingContactName String?          // Nombre de contacto para cobro
  billingContactEmail String?         // Correo de contacto para cobro
  approxPaymentDate  String?          // ejemplo quincena
  patients           Patient[]        // los ahijados
  sponsorPayments    SponsorPayment[] // todos sus pagos
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model SponsorPayment {
  id                String   @id @default(cuid())
  sponsorId         String
  sponsor           Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  amount            Float
  commission        Float    @default(0) // comisiones del banco
  paymentDate       DateTime
  paymentMethod     String   // como pago
  receiptNumber     String?  // recibo de su donativo
  authorizationCode String?  // autorizacion del banco
  periodCovered     String?  // ejemplo junio
  cfdiUse           String?  // cfdi para especie
  notes             String?  // notas
  status            String   @default("COMPLETED") // estatus pendiente cancelado etc
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}



enum PatientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED // baja porque no pago
}

// que toma el paciente
model PatientService {
  id             String       @id @default(cuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  frequency      Int          // cuantas veces
  scheduleType   String       // que horario es
  agreedPrice    Float        // precio acordado
  startDate      DateTime     @default(now())
}

// estado de cuenta
model Charge {
  id               String          @id @default(cuid())
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id])
  
  periodMonth      Int             // del 1 al 12
  periodYear       Int             // el año 2026
  concept          String?         // para otros cargos extra
  baseAmount       Float           // el precio de ese mes
  lateFee          Float           @default(0) // el recargo extra
  dueDate          DateTime        // calcular el quinto dia
  status           ChargeStatus    @default(PENDING)
  
  paymentAllocations PaymentCharge[]
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELLED
}

// todos los pagos
model Payment {
  id                    String        @id @default(cuid())
  patientId             String?       // nulo si fue rapido
  patient               Patient?      @relation(fields: [patientId], references: [id])
  
  // los datos del dinero
  totalBaseAmount       Float         // lo que sumo total
  totalLateFee          Float         @default(0) // suma de recargos
  quarterlyDiscount     Float         @default(0) // descuento del diez por ciento
  customDiscount        Float         @default(0) // descuento a mano
  customDiscountReason  String?       // poner si hay descuento
  finalAmountPaid       Float         // dinero en caja
  
  // relacion con cargos
  chargeAllocations     PaymentCharge[]
  
  // datos de transaccion
  paymentMethod         PaymentMethod
  status                PaymentStatus @default(COMPLETED) // pendiente por ser transferencia
  paymentDate           DateTime      @default(now())
  recordedBy            String        // quien lo registro
  receiptNumber         String?       @unique // folio en automatico
  isQuickPayment        Boolean       @default(false) // para saber si es valoracion
  quickPaymentName      String?       // nombre temporal
  quickPaymentNotes     String?       // cosas de caja rapida
  createdAt             DateTime      @default(now())
}

// tablita intermedia
model PaymentCharge {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId         String
  charge           Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amountAllocated  Float    // de cuanto fue a este cargo
  createdAt        DateTime @default(now())
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING    // transferencias pendientes
  COMPLETED
  CANCELLED
}

// configuracion del sistema
model SystemSettings {
  id                           Int        @id @default(1)
  lateFeePercentage            Float      @default(0.10) // el 10%
  quarterlyDiscount            Float      @default(0.10) // el 10%
  daysBeforeLateFee            Int        @default(5)    // 5 dias de gracia
  weeksBeforeSuspension        Int        @default(4)    // dar de baja en 4 semanas
  holidays                     DateTime[] // las vacaciones
  inscriptionFee               Float      @default(1700)
  patientCategories            String[]   @default(["FUNDACION", "PARTICULAR"])
  scheduleTypes                String[]   @default(["A", "B", "C"])
  exemptDiscountedFromLateFees Boolean    @default(true)
}

// gastos de la caja chica
model Expense {
  id               String   @id @default(cuid())
  concept          String
  amount           Float
  expenseDate      DateTime @default(now())
  recordedBy       String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
